---
import BaseLayout from './BaseLayout.astro';
import Backlinks from '../components/Backlinks.astro';
import Stamp from '../components/Stamp.astro';
import { isAlive } from '../lib/stato.mjs';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  fields?: [label: string, value: string | undefined][];
  status?: string;
  tags?: string[];
  backlinksUrl: string;
  image?: string;
}
const { title, description, kicker, tags = [], backlinksUrl, image } = Astro.props;
const fields = (Astro.props.fields ?? []).filter(([, value]) => value);
const status = isAlive(Astro.props.status) ? undefined : Astro.props.status;

const sections: Record<string, string> = {
  avventure: 'Avventure',
  personaggi: 'Personaggi',
  png: 'Png',
  luoghi: 'Luoghi',
};
const section = sections[backlinksUrl.split('/')[1]];
---
<BaseLayout title={title} description={description} type="article">
  <article class="sheet" data-pagefind-body data-pagefind-filter={section && `sezione:${section}`}>
    {status && <Stamp label={status} />}
    <header class="entry-header">
      {image && <img class="entry-image" src={image} alt={title} />}
      {kicker && <p class="entry-kicker" data-pagefind-ignore>{kicker}</p>}
      <h1 class="page-title" data-pagefind-weight="10">{title}</h1>
      {fields.length > 0 && (
        <dl class="entry-fields" data-pagefind-ignore>
          {fields.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      )}
      {tags.length > 0 && (
        <ul class="tag-list" data-pagefind-ignore>
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </header>
    <slot name="lead" />
    <div class="entry-content">
      <slot />
    </div>
    <div data-pagefind-ignore>
      <Backlinks url={backlinksUrl} />
      <slot name="after" />
    </div>
  </article>
</BaseLayout>
