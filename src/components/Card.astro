---
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  meta?: string;
  image?: string;
}
const { href, title, excerpt, meta, image } = Astro.props;
---
<a class="card" href={href}>
  {image && <img class="card-image" src={image} alt="" loading="lazy" />}
  <h2>{title}</h2>
  {meta && <p class="card-meta">{meta}</p>}
  {excerpt && <p>{excerpt}</p>}
</a>
